{
  "rewrites": [
    {
      "source": "/:slug((?!(?:api|admin|assets)$)[^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot).*"
        }
      ],
      "destination": "/api/og?slug=:slug"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/cron/cleanup", "schedule": "0 3 * * *" }]
}
